#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 ]]; then
    printf 'Usage: %s <image> <output>\n' "$(basename "$0")"
    exit 1
fi

image=$1
output=$2

if [[ ! -f $image ]]; then
    printf 'error: image not found: %s\n' "$image" >&2
    exit 1
fi

mkdir -p "$(dirname "$output")"

chafa --fg-only --polite on --format=symbols --symbols=ascii "$image" > "$output"

printf 'wrote: %s\n' "$output"
